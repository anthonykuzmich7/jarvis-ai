# Google Sheets waitlist sink.
# Copy to .env.local and fill in. See docs/google-sheets-setup.md.
# Leave these unset and the form still works — signups log to the console
# instead of the sheet.

# From the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# The service account's "client_email" — ends in .iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's "private_key". Keep the surrounding quotes and the
# literal \n sequences exactly as they appear in the downloaded JSON.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Tab name inside the spreadsheet. Defaults to "Waitlist" when unset.
GOOGLE_SHEETS_TAB_NAME=Waitlist
